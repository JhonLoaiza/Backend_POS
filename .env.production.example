# === PRODUCCIÓN - SmartPOS Backend ===
# Copia este archivo y renómbralo a .env en tu servidor de producción

# === SERVIDOR ===
NODE_ENV=production
PORT=5000

# === BASE DE DATOS - TiDB Cloud ===
# Obtén estas credenciales desde tu dashboard de TiDB Cloud
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_USER=tu_usuario_tidb
DB_PASSWORD=tu_password_tidb
DB_NAME=smartpos_prod
DB_PORT=4000

# === AUTENTICACIÓN ===
# CRÍTICO: Genera un JWT_SECRET NUEVO para producción
# Comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_NUEVO_DE_64_CARACTERES_AQUI
JWT_EXPIRES_IN=8h

# === CLOUDINARY (Almacenamiento de Imágenes) ===
# Obtén credenciales en: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# === FRONTEND ===
# URL de tu frontend en producción (sin slash al final)
FRONTEND_URL=https://tu-frontend.vercel.app
